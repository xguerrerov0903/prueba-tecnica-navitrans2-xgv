# ===================================================================
# Arranque Seguro - Reglas .gitignore del Proyecto
# ===================================================================

# Variables de entorno y secretos locales (R8)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
secrets/
config/secrets.*

# Configuraciones personales de Asistentes de IA (R8)
AGENTS.md
CLAUDE.md
.claude/
.cursor/
.codex/
.gemini/
.copilot/
*.code-workspace

# Logs y volcados de depuración
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Archivos del sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Entorno y artefactos de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
