# ============================================================
# backend/.dockerignore — Arranque Seguro
# Exclusiones específicas del contexto del backend
# ============================================================

# Python — artefactos compilados y caché
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
*.egg-info/

# Tests — no se necesitan en la imagen de producción
tests/

# Secretos
.env
.env.*
