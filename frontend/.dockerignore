# ============================================================
# frontend/.dockerignore — Arranque Seguro
# Exclusiones específicas del contexto del frontend
# ============================================================

# Dependencias instaladas localmente (se regeneran con npm ci)
node_modules/

# Bundle de producción generado localmente (se regenera con npm run build)
dist/

# Secretos de entorno
.env
.env.*
.env.local
.env.*.local

# IDEs y herramientas locales
.vscode/
.idea/
*.swp
