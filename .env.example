# ===================================================================
# Arranque Seguro - Variables de Entorno de Referencia
# ===================================================================

# Servicio opcional de redacción de IA de Navitrans
# Endpoint para enriquecimiento de lineamientos
NAVITRANS_AI_URL=https://redaccion-ia.navitrans.example/v1/introducciones

# Token de autenticación del servicio (asignado por Coordinación de Desarrollo)
# ADVERTENCIA: NUNCA guardes tokens de producción ni secretos reales en este archivo.
NAVITRANS_AI_TOKEN=reemplazar_con_token_asignado

# Tiempo límite de espera en segundos antes de activar el fallback local
NAVITRANS_AI_TIMEOUT_SECONDS=3.0

# ===================================================================
# Configuración del Backend
# ===================================================================
APP_ENV=development
PORT=8000
